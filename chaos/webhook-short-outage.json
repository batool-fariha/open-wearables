{
  "name": "Outgoing webhooks survive a short Svix outage",
  "scenario": "alert-service-outage",
  "pipeline": {
    "retry": { "maxRetries": 2, "baseSec": 5, "capSec": 5 },
    "deadLetterRedrive": false
  },
  "faults": [
    { "type": "outage", "target": "delivery", "startSec": 60, "durationSec": 8, "intensity": 1, "delaySec": 0 }
  ],
  "assertions": [
    { "kind": "service_unavailable_during_fault", "title": "The webhook sender notices the outage" },
    { "kind": "processed_after_recovery", "title": "Events raised during the outage are delivered after it ends" },
    { "kind": "no_unexpected_loss", "title": "No webhook event is lost" },
    { "kind": "recovery_time_max", "title": "Back to normal within 30 s", "params": { "maxSec": 30 } }
  ]
}
